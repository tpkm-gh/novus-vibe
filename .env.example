# --- Database ---
# Local docker-compose default. Point this at any Postgres 14+ instance.
DATABASE_URL=postgresql+psycopg://novus:novus@localhost:5432/novus_vibe

# Set to 1 to use an in-memory SQLite DB instead (zero setup, matches the
# schema but not every Postgres-specific behavior). Good for a first run.
USE_SQLITE_FALLBACK=1

# --- PDF generation provider ---
# mock  -> deterministic, fully offline, no Adobe account needed (default)
# live  -> real Adobe PDF Services API calls
PDF_PROVIDER=mock

# Only required when PDF_PROVIDER=live. From your Adobe Developer Console
# credential (Document Services > PDF Services API > OAuth Server-to-Server).
PDF_SERVICES_CLIENT_ID=
PDF_SERVICES_CLIENT_SECRET=

# --- Reflection provider (self-review of each generation job) ---
# rule_based -> deterministic PDF/structure checks (default, always available)
# llm        -> also asks a live model to critique the output
REFLECTION_PROVIDER=rule_based

# Only required when REFLECTION_PROVIDER=llm
ANTHROPIC_API_KEY=

# --- Misc ---
STORAGE_DIR=./storage
MAX_GENERATION_RETRIES=2
